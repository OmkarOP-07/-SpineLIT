# ── App ──────────────────────────────────────────────
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ── Security ─────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET_KEY=CHANGE_ME_GENERATE_A_SECURE_RANDOM_KEY

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Database ──────────────────────────────────────────
# SQLite (default — file stored in backend/ folder)
DATABASE_URL=sqlite:./spinelit.db

# PostgreSQL (uncomment when deploying)
# DATABASE_URL=postgresql://user:password@localhost:5432/spinelit

# ── Firebase ──────────────────────────────────────────
# Path to serviceAccountKey.json (relative to backend/)
# Download: Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_SERVICE_ACCOUNT_PATH=serviceAccountKey.json

# ── Email / OTP ───────────────────────────────────────
OTP_EXPIRE_MINUTES=10

# Gmail with App Password (recommended for dev):
#   1. Enable 2FA on Gmail
#   2. Go to myaccount.google.com → Security → App Passwords
#   3. Generate password for "Mail" + "Other device"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM=SpineLIT <your-email@gmail.com>

# Mailtrap (free sandbox — great for testing without sending real emails):
# SMTP_HOST=sandbox.smtp.mailtrap.io
# SMTP_PORT=2525
# SMTP_USER=<mailtrap-user>
# SMTP_PASS=<mailtrap-pass>
